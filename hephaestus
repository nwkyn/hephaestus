#!/usr/bin/env bash
# because you live in your terminal.

# examples:

# ./doc pacman/pacman README
# ./doc pacman/pacman wi/334
# ./doc pacman/pacman mr/314
# ./doc archlinux/packaging/packages/coreutils wi/10

# you can pipe this to "glow" for md formatting for instance
# or whatever people do with markdown in terminals/editors

# https://gitlab.archlinux.org / archlinux/packaging/packages/linux/
#        └── url server ───────┘   └──────── project path ─────────┘

# project path can consist of top level groups and several subgroups.

# here instead we query json, but the path guide above still applies
BASE_URL="https://gitlab.archlinux.org/api/v4"
# you could change this to any gitlab instance.

# default to the packaging guidelines or specify a project and file path you'd like to consult.
# plain paths: "/" is escaped to "%2F" below. this bypasses all anubis related blocks.

project="${1:-archlinux/developer-manual}"
file="${2:-content/package-guidelines/_index.md}"

# needed so that any curl error flows through, i.e 22 for 404
set -o pipefail

get() { curl -sSf "$BASE_URL/projects/${project//\//%2F}/$1"; }

header='"# \(.title) [\(.state)] by \(.author.username)\n\n\(.description)"'
diffs='.[] | "\n--- a/\(.old_path)\n+++ b/\(.new_path)\n\(.diff)"'

case "$file" in
  mr/*) get "merge_requests/${file#*/}"       | jq -r "$header"
        get "merge_requests/${file#*/}/diffs?per_page=100" | jq -r "$diffs" ;;
  wi/*) get "issues/${file#*/}"               | jq -r "$header" ;;
  *)    get "repository/files/${file//\//%2F}/raw?ref=HEAD" ;;
esac

# im not sure if very long diffs works, meh
